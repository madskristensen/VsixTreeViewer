<Project Sdk="MSTest.Sdk/4.0.1">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\VsixTreeViewer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <Target Name="CopyBuiltVsixForTests" AfterTargets="Build">
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\..\src\bin\$(Configuration)\net48\VsixTreeViewer.vsix"
      DestinationFolder="$(OutDir)"
      Condition="Exists('$(MSBuildProjectDirectory)\..\src\bin\$(Configuration)\net48\VsixTreeViewer.vsix')" />
  </Target>

</Project>
